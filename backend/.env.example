# ============================================================
# Afhiya Leathers Backend — environment template (copy to .env)
# Never commit real secrets.
# ============================================================

NODE_ENV=development
PORT=5000

# Database — same Atlas cluster OK; use a dedicated DB name per client
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/afhiyaleathers

# Auth
JWT_SECRET=replace_with_long_random_string

# CORS — must match live storefront / admin origins (no trailing slash)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Admin panel login (not customer accounts)
ADMIN_EMAIL=admin@afhiyaleathers.com
ADMIN_PASSWORD=Afhiya@Admin2026

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
CLOUDINARY_FOLDER=afhiya-leathers

# ------------------------------------------------------------
# Mail — production on Render: Resend HTTP API (recommended)
# Local fallback: Gmail SMTP still works if MAIL_PROVIDER=smtp
# ------------------------------------------------------------
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Zayn Leathers <orders@afiyaleather.com>"
EMAIL_REPLY_TO=afiyaleather8@gmail.com

# Optional local SMTP fallback (Gmail often blocked on Render)
# MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# Never true on Render / production
ALLOW_DEV_OTP=false

# ------------------------------------------------------------
# White-label feature modules (true/false)
# Charge clients per enabled add-on. Credentials still required below.
# ------------------------------------------------------------
FEATURE_RECOMMENDATIONS=true
# WhatsApp Lite (admin click-to-chat + storefront contact) — sellable add-on
FEATURE_WHATSAPP=false
FEATURE_COUPONS=true
FEATURE_INSTAGRAM=true
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_CATALOG_VARIANTS=true
FEATURE_MULTI_CURRENCY=true
FEATURE_PARTNER_ORDERS=false
FEATURE_INVOICING=false
FEATURE_ANALYTICS_PRO=false
# Analytics digest (requires FEATURE_ANALYTICS_PRO + mail configured)
# CRON_SECRET=                          # optional — protects POST /api/analytics/digest/run for external cron
# ANALYTICS_DIGEST_EMAIL=               # optional — override ADMIN_EMAIL for digest recipient
# LOW_STOCK_THRESHOLD=3                 # optional — dashboard low-stock alert threshold

# Invoice: autoGenerateOnDelivered + emailCustomerOnInvoice default true in admin Settings

# --- Razorpay (leave empty to disable online pay — checkout uses COD) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------
# Shipping partner (Shiprocket)
# ------------------------------------------------------------
SHIPPING_ENABLED=false
SHIPPING_PARTNER=shiprocket
SHIPPING_DYNAMIC_RATES=false

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_RETURN_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_RETURN_PINCODE=
SHIPROCKET_RETURN_NAME=Zayn Leathers Warehouse
SHIPROCKET_RETURN_ADDRESS=
SHIPROCKET_RETURN_CITY=
SHIPROCKET_RETURN_STATE=
SHIPROCKET_RETURN_PHONE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_DEFAULT_WEIGHT=0.5
SHIPROCKET_DEFAULT_LENGTH=30
SHIPROCKET_DEFAULT_BREADTH=25
SHIPROCKET_DEFAULT_HEIGHT=8

# ------------------------------------------------------------
# Partial payment (advance deposit)
# ------------------------------------------------------------
PARTIAL_PAYMENT_ENABLED=false
PARTIAL_PAYMENT_PERCENT_DEFAULT=20
PARTIAL_PAYMENT_MIN_PERCENT=10
PARTIAL_PAYMENT_MAX_PERCENT=50
PARTIAL_PAYMENT_MIN_ADVANCE=50
