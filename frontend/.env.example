# Frontend (Vite) — copy to .env / .env.production
# ─────────────────────────────────────────────────
# BACKEND MODE: Choose one of the two setups below
# ─────────────────────────────────────────────────

# ── Option A: Custom Node.js Backend (other clients / local) ──
# VITE_BACKEND_MODE=node
# VITE_BACKEND_URL=http://localhost:5000

# ── Option B: WooCommerce / Hostinger (Zayn client — preferred) ──
# No custom Node backend. Products/orders live on WordPress + WooCommerce.
VITE_BACKEND_MODE=woocommerce
VITE_WC_URL=https://zaynleather.com
VITE_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxx
VITE_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxx

# ── Razorpay (public key only) ──
# Leave empty to hide Razorpay on checkout
VITE_RAZORPAY_KEY_ID=

# ── Optional Overrides ──
# Override brand contact on the storefront (see shared/brands/zayn-leathers.js)
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_PHONE=
# VITE_SITE_URL=
